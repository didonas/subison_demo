datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// 1. Authentication & Authorization
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  roles    UserRole[]
  sessions Session[]

  // Audit relations
  createdAppointments   Appointment[]     @relation("AdminCreatedAppointments")
  confirmedAppointments Appointment[]     @relation("AdminConfirmedAppointments")
  checkedInAppointments Appointment[]     @relation("AdminCheckedInAppointments")
  appointmentNotes      AppointmentNote[] @relation("AdminAppointmentNotes")
  enquiryNotes          EnquiryNote[]     @relation("AdminEnquiryNotes")
  assignedEnquiries     PatientEnquiry[]  @relation("AdminAssignedEnquiries")
  resolvedEnquiries     PatientEnquiry[]  @relation("AdminResolvedEnquiries")
  auditLogs             AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "SUPER_ADMIN", "HOSPITAL_ADMIN", "RECEPTIONIST", "CONTENT_EDITOR"
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId String
  roleId String

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  adminUserId  String?
  action       String
  resourceType String
  resourceId   String?
  timestamp    DateTime @default(now())
  ipAddress    String?
  metadata     String? // JSON string

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([resourceType])
  @@index([timestamp])
  @@index([adminUserId])
}

// 2. Hospital Entities
model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  doctors      Doctor[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Doctor {
  id              String  @id @default(uuid())
  name            String
  qualifications  String
  specialisation  String
  experience      String?
  registration    String?
  bio             String?
  imageUrl        String?
  consultationFee Float
  departmentId    String

  department     Department           @relation(fields: [departmentId], references: [id])
  availabilities DoctorAvailability[]
  leaves         DoctorLeave[]
  appointments   Appointment[]
  profile        DoctorProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DoctorProfile {
  id                 String        @id @default(uuid())
  doctorId           String        @unique
  qualifications     String
  registrationNumber String
  specialisation     String
  experienceYears    Int?
  training           String?
  areasOfExpertise   Json?
  memberships        Json?
  languages          Json?
  bioEn              String?
  bioTa              String?
  consultationFee    Float
  publicNotice       String?
  isVerified         Boolean       @default(false)
  verifiedByAdminId  String?
  verifiedAt         DateTime?
  seoTitle           String?
  seoDescription     String?
  status             ContentStatus @default(DRAFT)
  version            Int           @default(1)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Medical Services and Content (Bilingual Architecture)
enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum FacilityVerification {
  UNVERIFIED
  VERIFIED
}

enum TestimonialStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum VideoProvider {
  YOUTUBE
  VIMEO
}

model Speciality {
  id                 String        @id @default(uuid())
  slug               String        @unique
  status             ContentStatus @default(DRAFT)
  displayOrder       Int           @default(0)
  featuredImageId    String?
  isFeatured         Boolean       @default(false)
  version            Int           @default(1)
  publishedAt        DateTime?
  publishedByAdminId String?
  createdByAdminId   String?
  updatedByAdminId   String?

  translations SpecialityTranslation[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpecialityTranslation {
  id                 String  @id @default(uuid())
  specialityId       String
  locale             String // "en" or "ta"
  title              String
  summary            String?
  overview           String?
  symptoms           Json? // list of symptoms
  causes             Json? // list of causes
  whenToSeekCare     String?
  diagnosticApproach String?
  treatmentApproach  String?
  seoTitle           String?
  seoDescription     String?

  speciality Speciality @relation(fields: [specialityId], references: [id], onDelete: Cascade)

  @@unique([specialityId, locale])
  @@index([specialityId])
}

model Treatment {
  id                 String        @id @default(uuid())
  slug               String        @unique
  status             ContentStatus @default(DRAFT)
  displayOrder       Int           @default(0)
  featuredImageId    String?
  version            Int           @default(1)
  publishedAt        DateTime?
  publishedByAdminId String?
  createdByAdminId   String?
  updatedByAdminId   String?

  translations TreatmentTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TreatmentTranslation {
  id                  String  @id @default(uuid())
  treatmentId         String
  locale              String // "en" or "ta"
  title               String
  summary             String?
  overview            String?
  candidateConditions Json? // list of conditions
  preparationInfo     String?
  diagnosticProcess   String?
  treatmentApproach   String?
  recoveryInfo        String?
  risksAndLimitations String?
  seoTitle            String?
  seoDescription      String?

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@unique([treatmentId, locale])
  @@index([treatmentId])
}

model Facility {
  id                 String               @id @default(uuid())
  slug               String               @unique
  status             ContentStatus        @default(DRAFT)
  verificationState  FacilityVerification @default(UNVERIFIED)
  displayOrder       Int                  @default(0)
  featuredImageId    String?
  version            Int                  @default(1)
  publishedAt        DateTime?
  publishedByAdminId String?
  createdByAdminId   String?
  updatedByAdminId   String?

  translations FacilityTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FacilityTranslation {
  id               String  @id @default(uuid())
  facilityId       String
  locale           String // "en" or "ta"
  name             String
  description      String?
  availabilityInfo String?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, locale])
  @@index([facilityId])
}

// 3. Scheduling & Appointments
model DoctorAvailability {
  id            String    @id @default(uuid())
  doctorId      String
  dayOfWeek     Int // 0 = Sunday, 1 = Monday, etc.
  startTime     String // "HH:MM"
  endTime       String // "HH:MM"
  slotDuration  Int // in minutes
  maxBookings   Int       @default(1)
  capacity      Int       @default(1)
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date

  doctor Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  breaks DoctorBreak[]

  @@index([doctorId, dayOfWeek])
}

model DoctorBreak {
  id                   String   @id @default(uuid())
  doctorAvailabilityId String
  name                 String // e.g. "Lunch Break"
  startTime            String // "HH:MM"
  endTime              String // "HH:MM"
  createdAt            DateTime @default(now())

  doctorAvailability DoctorAvailability @relation(fields: [doctorAvailabilityId], references: [id], onDelete: Cascade)

  @@index([doctorAvailabilityId])
}

model DoctorLeave {
  id               String   @id @default(uuid())
  doctorId         String
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  reason           String?
  createdAt        DateTime @default(now())
  createdByAdminId String?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startDate, endDate])
}

model BlockedSlot {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  startTime String? // If null, whole day is blocked
  endTime   String?
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model HospitalHoliday {
  id               String   @id @default(uuid())
  name             String   @default("Hospital Holiday")
  date             DateTime @unique @db.Date
  description      String
  createdByAdminId String?

  createdAt DateTime @default(now())

  @@index([date])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  REJECTED
  COMPLETED
  NO_SHOW
}

enum BookingChannel {
  ONLINE
  PHONE
  WALK_IN
  ADMIN
}

model Appointment {
  id                String         @id @default(uuid())
  bookingReference  String         @unique
  patientName       String
  mobileNumber      String
  alternativeNumber String?
  email             String?
  age               String?
  ageGroup          String?
  gender            String?
  patientType       String? // NEW or RETURNING
  preferredLanguage String? // EN or TA
  bookingChannel    BookingChannel @default(ONLINE)

  doctorId     String
  departmentId String
  specialityId String?

  appointmentDate DateTime @db.Date
  startTime       String // "HH:MM"
  endTime         String // "HH:MM"

  reasonForVisit String?
  status         AppointmentStatus @default(PENDING)
  internalNotes  String?
  version        Int               @default(1)

  activeSlotKey String?

  communicationConsent Boolean @default(false)
  privacyConsent       Boolean @default(false)

  checkedInAt        DateTime?
  checkedInByAdminId String?

  doctor           Doctor      @relation(fields: [doctorId], references: [id])
  department       Department  @relation(fields: [departmentId], references: [id])
  speciality       Speciality? @relation(fields: [specialityId], references: [id])
  checkedInByAdmin AdminUser?  @relation("AdminCheckedInAppointments", fields: [checkedInByAdminId], references: [id])

  history         AppointmentStatusHistory[]
  notes           AppointmentNote[]
  slotReservation SlotReservation?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdByAdminId   String?
  confirmedByAdminId String?

  createdByAdmin   AdminUser? @relation("AdminCreatedAppointments", fields: [createdByAdminId], references: [id])
  confirmedByAdmin AdminUser? @relation("AdminConfirmedAppointments", fields: [confirmedByAdminId], references: [id])

  @@index([bookingReference])
  @@index([mobileNumber])
  @@index([appointmentDate])
  @@index([status])
  @@index([bookingChannel])
  @@index([doctorId, appointmentDate, startTime])
  @@index([createdAt])
}

model SlotReservation {
  id              String   @id @default(uuid())
  doctorId        String
  appointmentDate DateTime @db.Date
  startTime       String // "HH:MM"
  position        Int // 1, 2, ... up to slot capacity
  appointmentId   String   @unique
  createdAt       DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([doctorId, appointmentDate, startTime, position])
  @@index([doctorId, appointmentDate, startTime])
}

model AppointmentNote {
  id            String   @id @default(uuid())
  appointmentId String
  authorAdminId String
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  authorAdmin AdminUser   @relation("AdminAppointmentNotes", fields: [authorAdminId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([authorAdminId])
}

model AppointmentStatusHistory {
  id            String            @id @default(uuid())
  appointmentId String
  status        AppointmentStatus
  notes         String?
  changedById   String?
  createdAt     DateTime          @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([createdAt])
}

// 4. Content & Other Entities
enum EnquiryStatus {
  UNREAD
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model PatientEnquiry {
  id               String  @id @default(uuid())
  name             String
  mobileNumber     String
  email            String?
  enquiryType      String
  message          String
  preferredContact String?
  consent          Boolean

  status            EnquiryStatus @default(UNREAD)
  assignedToAdminId String?
  resolvedAt        DateTime?
  resolvedByAdminId String?

  notes   EnquiryNote[]
  history EnquiryStatusHistory[]

  assignedToAdmin AdminUser? @relation("AdminAssignedEnquiries", fields: [assignedToAdminId], references: [id])
  resolvedByAdmin AdminUser? @relation("AdminResolvedEnquiries", fields: [resolvedByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model EnquiryNote {
  id            String   @id @default(uuid())
  enquiryId     String
  authorAdminId String
  content       String
  createdAt     DateTime @default(now())

  enquiry     PatientEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorAdmin AdminUser      @relation("AdminEnquiryNotes", fields: [authorAdminId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([authorAdminId])
}

model EnquiryStatusHistory {
  id               String        @id @default(uuid())
  enquiryId        String
  fromStatus       EnquiryStatus
  toStatus         EnquiryStatus
  changedByAdminId String?
  notes            String?
  createdAt        DateTime      @default(now())

  enquiry PatientEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([createdAt])
}

model Testimonial {
  id                 String            @id @default(uuid())
  patientDisplayName String
  patientLocation    String?
  content            String
  status             TestimonialStatus @default(PENDING_REVIEW)
  displayOrder       Int               @default(0)
  hasConsent         Boolean           @default(false)
  consentDate        DateTime?
  reviewedByAdminId  String?
  reviewedAt         DateTime?
  rejectionReason    String?
  version            Int               @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model MediaAsset {
  id                String        @id @default(uuid())
  storageKey        String        @unique
  publicUrl         String
  fileName          String
  fileSize          Int
  mimeType          String
  width             Int?
  height            Int?
  altTextEn         String?
  altTextTa         String?
  captionEn         String?
  captionTa         String?
  thumbnailUrl      String?
  album             String?
  displayOrder      Int           @default(0)
  status            ContentStatus @default(PUBLISHED)
  consentConfirmed  Boolean       @default(true)
  uploadedByAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([album])
}

model VideoItem {
  id           String        @id @default(uuid())
  provider     VideoProvider @default(YOUTUBE)
  videoId      String
  embedUrl     String
  thumbnailUrl String?
  titleEn      String?
  titleTa      String?
  captionEn    String?
  captionTa    String?
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  version      Int           @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Article {
  id                   String        @id @default(uuid())
  slug                 String        @unique
  category             String
  authorName           String
  isMedicalReviewed    Boolean       @default(false)
  reviewedByDoctorName String?
  featuredImageId      String?
  status               ContentStatus @default(DRAFT)
  version              Int           @default(1)
  publishedAt          DateTime?
  publishedByAdminId   String?
  createdByAdminId     String?
  updatedByAdminId     String?

  translations ArticleTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model ArticleTranslation {
  id             String  @id @default(uuid())
  articleId      String
  locale         String // "en" or "ta"
  title          String
  summary        String?
  content        Json // Rich-text blocks or structured sections
  seoTitle       String?
  seoDescription String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([articleId])
}

model FAQ {
  id              String        @id @default(uuid())
  category        String
  displayOrder    Int           @default(0)
  pageAssociation String?
  status          ContentStatus @default(DRAFT)
  version         Int           @default(1)

  translations FaqTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model FaqTranslation {
  id       String @id @default(uuid())
  faqId    String
  locale   String // "en" or "ta"
  question String
  answer   String

  faq FAQ @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
  @@index([faqId])
}

model NavigationItem {
  id           String  @id @default(uuid())
  labelEn      String
  labelTa      String?
  url          String
  isExternal   Boolean @default(false)
  displayOrder Int     @default(0)
  isEnabled    Boolean @default(true)
  version      Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PreviewToken {
  id         String   @id @default(uuid())
  token      String   @unique
  entityType String // "SPECIALITY", "TREATMENT", "ARTICLE", etc.
  entityId   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

model Notification {
  id            String    @id @default(uuid())
  type          String
  recipient     String
  channel       String // EMAIL, SMS, WHATSAPP
  status        String // PENDING, SENT, FAILED
  providerId    String?
  failureReason String?
  retryCount    Int       @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  lastErrorCode String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status])
  @@index([createdAt])
}

model NotificationTemplate {
  id        String  @id @default(uuid())
  type      String  @unique
  channel   String
  contentEn String
  contentTa String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RateLimit {
  id          String    @id @default(cuid())
  identifier  String
  action      String    @default("CONTACT_FORM")
  attempts    Int       @default(0)
  windowStart DateTime  @default(now())
  lastAttempt DateTime
  lockedUntil DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([identifier, action])
  @@index([expiresAt])
  @@index([lockedUntil])
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String // JSON string

  updatedAt DateTime @updatedAt
}

model SocialLink {
  id           String @id @default(uuid())
  platform     String
  url          String
  displayOrder Int    @default(0)
}
