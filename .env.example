# =============================================================================

# SUBISON NEURO CENTRE — ENVIRONMENT CONFIGURATION TEMPLATE

# =============================================================================

# Copy this file to .env for local development.

# Never commit .env or actual secrets to GitHub.

# -----------------------------------------------------------------------------

# DATABASE — NEON POSTGRESQL

# -----------------------------------------------------------------------------

# Pooled connection used by the running application.

DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require"

# Direct connection used by Prisma migrations.

DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# -----------------------------------------------------------------------------

# APPLICATION URL

# -----------------------------------------------------------------------------

# Local development:

PUBLIC_APP_URL="http://localhost:3000"

# Set these only when the corresponding environment exists.

DEVELOPMENT_PUBLIC_URL="http://localhost:3000"
STAGING_PUBLIC_URL=""
PRODUCTION_PUBLIC_URL=""

# -----------------------------------------------------------------------------

# AUTHENTICATION AND SECURITY

# -----------------------------------------------------------------------------

# Generate two different 64-character hexadecimal values.

AUTH_SECRET="GENERATE_A_64_CHARACTER_HEX_SECRET"
RATE_LIMIT_SECRET="GENERATE_A_DIFFERENT_64_CHARACTER_HEX_SECRET"

# Valid values:

# direct      — local development

# vercel      — Vercel deployment

# cloudflare  — Cloudflare-restricted origin

# nginx       — trusted NGINX reverse proxy

TRUSTED_PROXY_MODE="direct"

CSP_REPORT_ONLY="true"

# -----------------------------------------------------------------------------

# DEMO MODE AND SEED ADMIN

# -----------------------------------------------------------------------------

DEMO_MODE="true"

# Keep only the variable names actually used by prisma/seed.ts.

SEED_ADMIN_EMAIL="[admin@subison-demo.local](mailto:admin@subison-demo.local)"
SEED_ADMIN_PASSWORD="SET_IN_LOCAL_ENV_OR_VERCEL"
SEED_ADMIN_NAME="Super Administrator"

# -----------------------------------------------------------------------------

# CLOUDFLARE TURNSTILE — DEMO TEST KEYS

# -----------------------------------------------------------------------------

# These are Cloudflare's official testing keys.

# They must not be treated as real production credentials.

NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_ENABLED="true"

# -----------------------------------------------------------------------------

# MEDIA STORAGE

# -----------------------------------------------------------------------------

# Use cloudinary for Vercel deployments.

# Local storage is suitable only for local development.

STORAGE_PROVIDER="cloudinary"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -----------------------------------------------------------------------------

# EMAIL NOTIFICATIONS

# -----------------------------------------------------------------------------

# Keep disabled for the demo when Resend is not configured.

EMAIL_NOTIFICATIONS_ENABLED="false"

RESEND_API_KEY=""
RESEND_FROM_EMAIL="[appointments@example.com](mailto:appointments@example.com)"
APPOINTMENT_ADMIN_EMAIL="[admin@example.com](mailto:admin@example.com)"

